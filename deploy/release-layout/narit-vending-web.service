[Unit]
Description=Narit Vending Web Monitor (versioned mockup release)
After=network-online.target narit-vending-controller.service
Wants=network-online.target
Requires=narit-vending-controller.service

[Service]
Type=simple
WorkingDirectory=/home/admin/NaritVendingMOCKUP/current
EnvironmentFile=-/etc/narit-vending.env
ExecStart=/home/admin/NaritVendingMOCKUP/shared/.venv/bin/python3 -m narit_vending.web --host 0.0.0.0 --port 80 --hw-config /home/admin/NaritVendingMOCKUP/shared/config/hardware_config.json
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target

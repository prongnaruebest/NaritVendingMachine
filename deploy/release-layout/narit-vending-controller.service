[Unit]
Description=Narit Vending Controller (versioned mockup release)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/home/admin/NaritVendingMOCKUP/current
EnvironmentFile=-/etc/narit-vending.env
ExecStart=/home/admin/NaritVendingMOCKUP/shared/.venv/bin/python3 -m narit_vending.controller --config /home/admin/NaritVendingMOCKUP/shared/config/machine_config.json --hw-config /home/admin/NaritVendingMOCKUP/shared/config/hardware_config.json --persistence-db /home/admin/NaritVendingMOCKUP/shared/config/controller_history.sqlite3
RuntimeDirectory=narit-vending
RuntimeDirectoryMode=0755
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target

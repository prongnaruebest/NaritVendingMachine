[Unit]
Description=Narit Vending Controller (versioned IRIV release)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/home/admin/NaritVendingV1/current
EnvironmentFile=-/etc/narit-vending.env
ExecStart=/usr/bin/env GPIOZERO_PIN_FACTORY=rpigpio /home/admin/NaritVendingV1/shared/.venv/bin/python3 -m narit_vending.controller --config /home/admin/NaritVendingV1/shared/config/machine_config.iriv.json --hw-config /home/admin/NaritVendingV1/shared/config/hardware_config.iriv.json --persistence-db /home/admin/NaritVendingV1/shared/config/controller_history.sqlite3
RuntimeDirectory=narit-vending
RuntimeDirectoryMode=0755
Restart=always
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target

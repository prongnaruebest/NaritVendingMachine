[Unit]
Description=Narit Vending Controller (IRIV Pi + IRIV IO)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/home/admin/NaritVendingV1
EnvironmentFile=-/etc/narit-vending.env
ExecStart=/home/admin/NaritVendingV1/.venv/bin/python3 -m narit_vending.controller --config /home/admin/NaritVendingV1/machine_config.iriv.json --hw-config /home/admin/NaritVendingV1/hardware_config.iriv.json
RuntimeDirectory=narit-vending
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
